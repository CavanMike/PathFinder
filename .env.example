# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Option A: one connection string (works for Supabase or local PostgreSQL)
# Supabase: Project Settings > Database > Connection string (URI)
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-xx.pooler.supabase.com:5432/postgres
# DB_SSL_REQUIRE=True

# Option B: local PostgreSQL, separate values
DB_NAME=pathfinder
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
